# ============================================================================
# Project Specific Exclusions
# ============================================================================

# Exclude test credentials or connection strings
test-credentials.ps1
test-config.json

# Exclude large test data sets
testdata/
sample-data/

# Exclude generated documentation
generated-docs/

# Keep but ignore local examples
examples/local/
examples/*.local.ps1

# ============================================================================
# IMPORTANT: Files to KEEP in Repository
# ============================================================================
# The following should NOT be ignored (explicitly tracked):
# - Invoke-LocalAccountCleanup.ps1
# - Test-RemoteConnectivity.ps1
# - Show-Banner.ps1
# - Validate-Scripts.ps1
# - usage_guide.md
# - TESTING.md
# - QUICKSTART-TESTING.md
# - BANNER-README.md
# - banner.txt
# - Tests/*.Tests.ps1
# - README.md (if exists)
# - LICENSE (if exists)
# ============================================================================
