# ============================================================================
# PowerShell Local Account Cleanup - .gitignore
# ============================================================================

# ============================================================================
# Testing and Development Files
# ============================================================================

# PowerShell installation packages (from testing setup)
*.deb
*.rpm
*.msi
*.pkg

# Demo and test files
demo-*.ps1
test-*.ps1

# ============================================================================
# Script Output and Logs
# ============================================================================

# Log directories
Logs/
logs/
C:\Scripts\Logs/

# Log files
*.log
*.txt.log
*_*.log
LocalAccountCleanup_*.log
AccountReport_*.csv
Errors_*.log
ConnectivityTest_*.csv

# Backup directories
Backups/
Backups_*/
*_backup/

# Report files (generated at runtime)
AccountReport_*.csv
*Report*.csv

# ============================================================================
# PowerShell Specific
# ============================================================================

# PowerShell module cache
*.psm1.cache

# PowerShell session state
*.ps1xml

# PowerShell debugging
*.pdb

# PSScriptAnalyzer settings (if custom)
PSScriptAnalyzerSettings.psd1.user

